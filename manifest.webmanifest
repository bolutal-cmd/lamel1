{
  "name": "Lamel: mikroskopi görüntü aracı",
  "short_name": "Lamel",
  "description": "Mikroskopi görüntülerini açma, bölge çizme ve ölçme aracı. Görüntüler cihazdan çıkmaz.",
  "lang": "tr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#13171B",
  "theme_color": "#1A1F24",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-leica-lif": [".lif"],
        "image/tiff": [".tif", ".tiff"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"]
      }
    }
  ]
}
